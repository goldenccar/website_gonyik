# Application
JWT_SECRET=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=https://example.com
TRUST_PROXY=1

# One-time local administrator initialization; remove values after npm run admin:init
GONYIK_INITIAL_ADMIN_USERNAME=
GONYIK_INITIAL_ADMIN_PASSWORD=

# Optional data paths (tests set isolated temporary values automatically)
GONYIK_DB_PATH=
GONYIK_UPLOADS_DIR=

# Deployment, configured only on the trusted operator machine or CI
GONYIK_DEPLOY_HOST=
GONYIK_DEPLOY_USER=
GONYIK_DEPLOY_PATH=
GONYIK_DEPLOY_SSH_KEY=
GONYIK_DEPLOY_PORT=22
GONYIK_DEPLOY_KNOWN_HOSTS=

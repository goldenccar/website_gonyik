{
  "compilerOptions": {
    "skipLibCheck": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "vite.config.ts",
    "server/**/*.ts",
    "src/config/fabricCapabilities.ts",
    "src/config/materialPlatforms.ts",
    "src/config/technologyPages.ts"
  ]
}
